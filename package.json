{
  "name": "js-capstone-endless-runner",
  "version": "1.0.0",
  "description": "Sunny Land: an endless runner game made with Phaser and webpack.",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "dev": "webpack --mode development",
    "watch": "webpack --watch --mode development",
    "build": "webpack --mode production",
    "test": "jest",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "smoke": "node tools/smoke-test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vichuge/js-capstone-endless-runner.git"
  },
  "keywords": [],
  "author": "Victor Pacheco",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vichuge/js-capstone-endless-runner/issues"
  },
  "homepage": "https://github.com/vichuge/js-capstone-endless-runner#readme",
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "babel-jest": "^30.5.2",
    "css-loader": "^7.1.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-fetch-mock": "^4.2.0",
    "playwright": "^1.64.1",
    "style-loader": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^5.2.7"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ]
